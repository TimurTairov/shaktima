---
import { Image } from "astro:assets";
import tirthadeva from "../assets/yoga-teachers/tirthadeva-96.webp";
import tarini from "../assets/yoga-teachers/tarini.jpg";
import madhavapriya from "../assets/yoga-teachers/madhavapriya.jpg";
import lalitasundari from "../assets/yoga-teachers/lalitasundari.jpg";
import taramati from "../assets/yoga-teachers/taramati.jpg";
import {
  Tabs,
  TabsList,
  TabsTrigger,
  TabsContent,
} from "@/components/starwind/tabs";
---

<h1 class="mainTitle">Расписание занятий</h1>

<div class="mt-5 flex w-full flex-col items-center justify-center">
  <Tabs defaultValue="pn" class="w-full px-0.5 lg:px-2">
    <TabsList class="flex w-full items-center justify-between">
      <TabsTrigger value="pn">
        <p class="hidden lg:block">Понедельник</p>
        <p class="block lg:hidden">Пн</p>
      </TabsTrigger>
      <TabsTrigger value="vt">
        <p class="hidden lg:block">Вторник</p>
        <p class="block lg:hidden">Вт</p>
      </TabsTrigger>
      <TabsTrigger value="sr">
        <p class="hidden lg:block">Среда</p>
        <p class="block lg:hidden">Ср</p>
      </TabsTrigger>
      <TabsTrigger value="cht">
        <p class="hidden lg:block">Четверг</p>
        <p class="block lg:hidden">Чт</p>
      </TabsTrigger>
      <TabsTrigger value="pt">
        <p class="hidden lg:block">Пятница</p>
        <p class="block lg:hidden">Пт</p>
      </TabsTrigger>
      <TabsTrigger value="sb">
        <p class="hidden lg:block">Суббота</p>
        <p class="block lg:hidden">Сб</p>
      </TabsTrigger>
      <TabsTrigger value="vs">
        <p class="hidden lg:block">Воскресение</p>
        <p class="block lg:hidden">Вс</p>
      </TabsTrigger>
    </TabsList>
    <TabsContent value="pn">
      <div class="flex w-full flex-col gap-1">
        <div class="grid-item-rasp bg-amber-100">
          <p class="w-full text-center">19:00 - 21:00</p>
          <b class="w-full text-center">Бхаджан Мандала</b>
          <p class="w-full text-center font-light italic">Пуджа Шиве</p>
          <!-- <p class="text-red-600">Отмена занятия</p> -->
        </div>
      </div>
    </TabsContent>
    <TabsContent value="vt">
      <div class="flex w-full flex-col gap-1">
        <div class="grid-item-rasp bg-amber-100">
          <p class="w-full text-center">17:00 - 19:00</p>
          <b class="w-full text-center">Бхаджан Мандала</b>
          <p class="w-full text-center font-light italic">Пуджа Даттатрее</p>
        </div>
        <div class="grid-item-rasp bg-blue-100">
          <p class="w-full text-center">19:00 - 21:00</p>
          <b class="w-full text-center">Йога сиддхов</b>
          <p class="w-full text-center font-light italic">Мадхаваприя</p>
          <!-- <p class="text-red-600">Отмена занятия</p> -->
        </div>
      </div>
    </TabsContent>
    <TabsContent value="sr">
      <div class="flex w-full flex-col gap-1">
        <div class="grid-item-rasp bg-amber-100">
          <p class="w-full text-center">19:00 - 21:30</p>
          <b class="w-full text-center">Бхаджан Мандала</b>
          <p class="w-full text-center font-light italic">
            Пуджа Вишну и Садхана Риши Дханвантари
          </p>
          <!-- <p class="text-red-600">Отмена занятия</p> -->
        </div>
      </div>
    </TabsContent>
    <TabsContent value="cht">
      <div class="flex w-full flex-col gap-1">
        <div class="grid-item-rasp bg-blue-100">
          <p class="w-full text-center">10:00 - 11:25</p>
          <b class="w-full text-center">Йога сиддхов</b>
          <p class="w-full text-center font-light">Тарини</p>
          <!-- <p class="w-full text-center text-red-600">Отмена занятия</p> -->
        </div>
        <div class="grid-item-rasp bg-amber-100">
          <p class="w-full text-center">11:30 - 12:00</p>
          <b class="w-full text-center">Сутра</b>
          <p class="w-full text-center font-light italic">Пуджа Даттатрее</p>
          <!-- <p class="w-full text-center text-red-600">Отмена занятия</p> -->
        </div>
        <div class="grid-item-rasp bg-amber-100">
          <p class="w-full text-center">18:30 - 21:30</p>
          <b class="w-full text-center">Бхаджан Мандала</b>
          <!-- <p class="w-full text-center font-light italic">Пуджа Гуру</p> -->
          <p class="text-red-600">Отмена занятия</p>
        </div>
      </div>
    </TabsContent>
    <TabsContent value="pt">
      <div class="flex w-full flex-col gap-1">
        <!-- <div class="grid-item-rasp bg-blue-100">
          <p class="w-full text-center">10:00 - 11:25</p>
          <b class="w-full text-center">Шат чакра крийя йога</b>
          <p class="w-full text-center font-light">Мадхаваприя</p>
        </div>
        <div class="grid-item-rasp bg-amber-100">
          <p class="w-full text-center">11:30 - 12:00</p>
          <b class="w-full text-center">Сутра. Брахма мантра</b>
          <p class="w-full text-center font-light italic">Пуджа Даттатрее</p>
        </div> -->
        <div class="grid-item-rasp bg-amber-100">
          <p class="w-full text-center">18:00 - 21:00</p>
          <b class="w-full text-center">Бхаджан Мандала</b>
          <!-- <p class="w-full text-center font-light italic">Пуджа Шакти</p> -->
          <p class="text-red-600">Отмена занятия</p>
        </div>
      </div>
    </TabsContent>
    <TabsContent value="sb">
      <div class="flex w-full flex-col gap-1">
        <div class="grid-item-rasp bg-blue-100">
          <p class="w-full text-center">10:00 - 12:00</p>
          <b class="w-full text-center">Практики ветра, пранаямы, медитации</b>
          <p class="w-full text-center font-light">Мадхаваприя</p>
        </div>
        <!-- <div class="grid-item-rasp bg-blue-100">
          <p class="w-full text-center">13:00 - 14:30</p>
          <b class="w-full text-center">Медитация 4БСБ</b>
          <b class="w-full text-center font-light">Лалитасундари</b>
          <p class="w-full text-center text-red-600">Отмена занятия!</p>
        </div> -->
        <div class="grid-item-rasp bg-amber-100">
          <p class="w-full text-center">13:00 - 14:30</p>
          <b class="w-full text-center">Бхаджан Мандала</b>
          <p class="w-full text-center font-light italic">
            Пуджа Ганеши. Гуру-йога почитания Парамгуру Авадхуты Свами
            Брахмананды
          </p>
        </div>
      </div>
    </TabsContent>
    <TabsContent value="vs">
      <div class="flex w-full flex-col gap-1">
        <div class="grid-item-rasp bg-fuchsia-200">
          <p class="w-full text-center">9:30 - 19:00</p>
          <b class="w-full text-center">
            <a
              href="/mdc-events/dhiyana"
              class="text-indigo-700 hover:underline dark:text-amber-400"
              >Медитатвный ретрит для всех желающих
            </a>
          </b>
          <p class="w-full text-center font-light">Тиртхадева</p>
        </div>
      </div>
    </TabsContent>
  </Tabs>

  <p class="mt-5 w-full text-right text-xs font-light text-gray-400">
    Обновлено: 15.07.2026 16:30
  </p>
  <h3
    class="mt-5 mb-1 text-base font-medium text-gray-700 md:mt-5 lg:mt-10 dark:text-amber-600"
  >
    Условные обозначения
  </h3>

  <div
    class="grid w-full grid-cols-1 gap-2 text-gray-700 md:grid-cols-2 lg:grid-cols-4 dark:text-amber-100"
  >
    <div class="flex w-full items-center gap-1">
      <div class="size-8 shrink-0 rounded-md bg-green-100"></div>
      <p class="w-full text-xs">
        Телесные практики: асаны, виньясы, вьяямы, физические крии.
      </p>
    </div>
    <div class="flex items-center gap-1">
      <div class="size-8 shrink-0 rounded-md bg-blue-100"></div>
      <p class="w-full text-xs">
        Дыхательные и ментальные практики: пранаямы, медитации, мантры.
      </p>
    </div>
    <div class="flex items-center gap-1">
      <div class="size-8 shrink-0 rounded-md bg-amber-100"></div>
      <p class="w-full text-xs">
        Алтарные садханы: ритуальные практики у алтаря.
      </p>
    </div>
    <div class="flex items-center gap-1">
      <div class="size-8 shrink-0 rounded-md bg-fuchsia-200"></div>
      <p class="w-full text-xs">Семинары и ретриты выходного дня.</p>
    </div>
  </div>

  <h3
    class="my-1 mt-5 text-base font-medium text-gray-700 md:mt-5 lg:mt-10 dark:text-amber-600"
  >
    Запишитесь на практику
  </h3>

  <div class="flex flex-col gap-2">
    <div
      class="grid w-full grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3 xl:gap-10"
    >
      <!--! ТАРИНИ -->
      <div
        class="flex flex-col justify-between rounded-md bg-amber-100 p-2 text-sm text-slate-700 transition-all duration-700 ease-in dark:bg-slate-700 dark:text-white"
      >
        <div class="my-2 flex w-full flex-col items-center justify-center">
          <Image src={tarini} alt="" class="rounded-full" />
          <p class="text-lg font-medium text-gray-700 dark:text-amber-600">
            Тарини
          </p>
        </div>

        <div class="flex flex-col gap-1 dark:text-amber-100">
          <p class="mt-1">Расписание:</p>
          <p class="font-light">• Чт 10:00 Йога сиддхов</p>
        </div>

        <div class="mt-5 flex gap-1 dark:text-amber-100">
          <p class="">Контакты:</p>
          <a
            href="whatsapp://send?phone=79154779637"
            target="_blank"
            rel="noreferrer"
            class="text-indigo-700 hover:underline dark:text-amber-400"
          >
            whapsapp
          </a>
          <a
            href="https://t.me/om_tarini"
            target="_blank"
            rel="noreferrer"
            class="text-indigo-700 hover:underline dark:text-amber-400"
          >
            telegram
          </a>
        </div>
      </div>

      <!--! Мадхаваприя -->
      <div
        class="flex flex-col justify-between rounded-md bg-amber-100 p-2 text-sm text-slate-700 transition-all duration-700 ease-in dark:bg-slate-700 dark:text-white"
      >
        <div class="my-2 flex w-full flex-col items-center justify-center">
          <Image src={madhavapriya} alt="" class="rounded-full" />
          <p class="text-lg font-medium text-gray-700 dark:text-amber-600">
            Мадхаваприя
          </p>
        </div>
        <div class="flex flex-col gap-1 dark:text-amber-100">
          <p class="mt-1">Расписание:</p>
          <p class="font-light">• Вт 19:00 Комплекс ветра + пранаяма</p>
          <p class="font-light">• Пт 10:00 Шат чакра крийя йога</p>
          <p class="font-light">
            • Сб 10:00 Практики ветра, пранаямы, медитации
          </p>
        </div>

        <div class="mt-5 flex gap-1">
          <p class="">Контакты:</p>
          <a
            href="whatsapp://send?phone=79852597978"
            target="_blank"
            rel="noreferrer"
            class="text-indigo-700 hover:underline dark:text-amber-400"
          >
            whatsapp
          </a>
          <a
            href="https://t.me/margo9978"
            target="_blank"
            rel="noreferrer"
            class="text-indigo-700 hover:underline dark:text-amber-400"
          >
            telegram
          </a>
        </div>
        <div class="w-full"></div>
      </div>

      <!--! Лалитасундари -->
      <div
        class="flex flex-col justify-between rounded-md bg-amber-100 p-2 text-sm text-slate-700 transition-all duration-700 ease-in dark:bg-slate-700 dark:text-white"
      >
        <div class="my-2 flex w-full flex-col items-center justify-center">
          <Image src={lalitasundari} alt="" class="rounded-full" />
          <p class="text-lg font-medium text-gray-700 dark:text-amber-600">
            Лалитасундари
          </p>
        </div>
        <button class="flex w-full items-center gap-1 rounded-md">
          <span class="text-xl font-medium text-gray-700 dark:text-amber-600">
          </span>
        </button>

        <div class="flex flex-col gap-1 dark:text-amber-100">
          <p class="mt-1">Расписание:</p>
          <p class="font-light">• Сб 16:00 Медитация 4БСБ</p>
        </div>

        <div class="mt-5 flex gap-1 dark:text-amber-100">
          <p class="">Контакты:</p>
          <a
            href="whatsapp://send?phone=79637239294"
            target="_blank"
            rel="noreferrer"
            class="text-indigo-700 hover:underline dark:text-amber-400"
          >
            whatsapp
          </a>
          <a
            href="https://t.me/lido108"
            target="_blank"
            rel="noreferrer"
            class="text-indigo-700 hover:underline dark:text-amber-400"
          >
            telegram
          </a>
        </div>
      </div>

      <!--! Тарамати -->
      <div
        class="flex flex-col rounded-md bg-amber-100 p-2 text-sm text-slate-700 transition-all duration-700 ease-in dark:bg-slate-700 dark:text-white"
      >
        <div class="my-2 flex w-full flex-col items-center justify-center">
          <Image src={taramati} alt="" class="rounded-full" />
          <p class="text-lg font-medium text-gray-700 dark:text-amber-600">
            Запись на пуджу
          </p>
        </div>

        <div class="flex flex-col gap-1 dark:text-amber-100">
          <p class="mt-1">Расписание:</p>
          <p class="font-light">• Утрення пуджа Даттатрее</p>
          <p class="font-light">• Вечерняя пуджа (по дням недели)</p>
        </div>

        <div class="mt-5 flex gap-1 dark:text-amber-100">
          <p class="">Контакты:</p>
          <a
            href="whatsapp://send?phone=79852191619"
            target="_blank"
            rel="noreferrer"
            class="text-indigo-700 hover:underline dark:text-amber-400"
            >whatsapp
          </a>
          <a
            href="https://t.me/Shartatiana"
            target="_blank"
            rel="noreferrer"
            class="text-indigo-700 hover:underline dark:text-amber-400"
            >telegram
          </a>
        </div>
      </div>

      <!--! Тиртхадева -->
      <div
        class="flex flex-col justify-between rounded-md bg-amber-100 p-2 text-sm text-slate-700 transition-all duration-700 ease-in dark:bg-slate-700 dark:text-white"
      >
        <div class="my-2 flex w-full flex-col items-center justify-center">
          <Image src={tirthadeva} alt="" class="rounded-full" />
          <p class="text-lg font-medium text-gray-700 dark:text-amber-600">
            Тиртхадева
          </p>
        </div>

        <div class="flex flex-col gap-1 dark:text-amber-100">
          <p class="mt-1">Расписание:</p>
          <p class="font-light">
            • Воскресение 26 июля 9:30 - 19:00
            <a
              href="/mdc-events/dharana"
              class="text-xs text-indigo-700 hover:underline dark:text-amber-400"
              >Ретрит по концентрации: ВНУТРИ ТОЧКИ — БЕСКОНЕЧНОСТЬ
            </a>
          </p>
        </div>

        <div class="flex gap-1 dark:text-amber-100">
          <p class="">Контакты:</p>
          <a
            href="whatsapp://send?phone=79672067710"
            target="_blank"
            rel="noreferrer"
            class="text-indigo-700 hover:underline dark:text-amber-400"
            >whatsapp
          </a>
          <a
            href="https://t.me/tirthadeva"
            target="_blank"
            rel="noreferrer"
            class="text-indigo-700 hover:underline dark:text-amber-400"
            >telegram
          </a>
        </div>
      </div>
    </div>
    <span
      class="mt-1 inline-flex gap-1 text-xs text-gray-700 dark:text-amber-100"
      >В сообщении обязательно укажите время и день занятия!</span
    >

    <div class="mt-7 flex w-full justify-center">
      <a
        href="/contacts#address"
        class="my-button flex items-center gap-1 rounded-md border border-gray-300 px-3 py-2 text-center"
      >
        <p>Как нас найти</p>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
        >
          <path
            fill="currentColor"
            d="M21.623 4.103c.521-1.1-.626-2.248-1.726-1.726L2.99 10.385c-1.1.52-.94 2.133.24 2.429l6.364 1.59l1.591 6.364c.295 1.18 1.908 1.34 2.43.24z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</div>
