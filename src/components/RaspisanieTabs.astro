---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import tirthadeva from "../assets/yoga-teachers/tirthadeva-96.webp";
import tarini from "../assets/yoga-teachers/tarini.jpg";
import madhavapriya from "../assets/yoga-teachers/madhavapriya.jpg";
import lalitasundari from "../assets/yoga-teachers/lalitasundari.jpg";
import taramati from "../assets/yoga-teachers/taramati.jpg";
import uma from "@/assets/yoga-teachers/uma.jpg";
import {
  Tabs,
  TabsList,
  TabsTrigger,
  TabsContent,
} from "@/components/starwind/tabs";
